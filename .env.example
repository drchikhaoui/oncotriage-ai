ANTHROPIC_API_KEY=your_api_key_here
DATABASE_URL=sqlite+aiosqlite:///./oncotriage.db
APP_ENV=development
LOG_LEVEL=INFO
# Set to true to disable LLM and use structured form only (HIPAA-safe fallback)
DISABLE_LLM=false

# ── Vision provider fallback chain ──────────────────────────────────────────────
# Providers are tried in order: Gemini → OpenRouter → Groq → HuggingFace
# Any provider without an API key is automatically skipped.

# Google AI Studio (primary — free tier: 1,500 req/day, 15 RPM)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here

# OpenRouter (fallback 1 — gemini-2.5-flash:free tier available)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq (fallback 2 — llama-3.2-90b-vision, generous free tier)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# HuggingFace Inference API (fallback 3 — cold starts ~30s)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Set to true to disable the photo triage module entirely
DISABLE_VISION=false
